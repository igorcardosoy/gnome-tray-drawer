#: prefs.js:10
msgid "Automatic (follow panel)"
msgstr "Automática (seguir o painel)"

#: prefs.js:13
msgid "Automatic (system)"
msgstr "Automático (idioma do sistema)"

#: prefs.js:11
msgctxt "arrow direction"
msgid "Down"
msgstr "Para baixo"

#: prefs.js:12
msgctxt "arrow direction"
msgid "Up"
msgstr "Para cima"

#: prefs.js:13
msgctxt "arrow direction"
msgid "Left"
msgstr "Para a esquerda"

#: prefs.js:14
msgctxt "arrow direction"
msgid "Right"
msgstr "Para a direita"

#: prefs.js:26
msgid "Drawer button"
msgstr "Botão da gaveta"

#: prefs.js:27
msgid ""
"By default the arrow points away from the panel edge, so it follows panels "
"placed at the top, bottom, left or right."
msgstr ""
"Por padrão, a seta aponta para longe da borda do painel, acompanhando "
"painéis posicionados no topo, embaixo, à esquerda ou à direita."

#: prefs.js:32
msgid "Arrow direction"
msgstr "Direção da seta"

#: prefs.js:33
msgid "Choose where the arrow points when the drawer is closed."
msgstr "Escolha para onde a seta aponta quando a gaveta está fechada."

#: prefs.js:50
msgid "Rotate the arrow when opening"
msgstr "Girar a seta ao abrir"

#: prefs.js:51
msgid ""
"Flip the arrow when the drawer is open, so it points back towards the panel "
"edge."
msgstr ""
"Gira a seta quando a gaveta está aberta, para que ela aponte de volta para a "
"borda do painel."

#: prefs.js:57
msgid "Animate the arrow"
msgstr "Animar a seta"

#: prefs.js:58
msgid "Rotate the arrow smoothly when the drawer opens or closes."
msgstr "Gira a seta suavemente quando a gaveta abre ou fecha."

#: lib/indicatorDiscovery.js:20
msgid "Application"
msgstr "Aplicativo"

#: lib/overflowGrid.js:19
msgid "No hidden icons - middle-click or drag an app here"
msgstr ""
"Nenhum ícone oculto - clique com o botão do meio ou arraste um app aqui"

#: lib/trayToggleButton.js:38
msgid "Tray Toggle"
msgstr "Alternar bandeja"

#: prefs.js:63
msgid "Interface language"
msgstr "Idioma da interface"

#: prefs.js:95
msgid "Choose the language used by the extension."
msgstr "Escolha o idioma usado pela extensão."
